{
  "name": "cs2-smoke-bot",
  "version": "1.0.0",
  "description": "Telegram bot for CS2 grenade lineups",
  "main": "dist/index.js",
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "lodash": "^4.17.21",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/node": "^20.11.17",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "cs2",
    "telegram",
    "bot",
    "smoke"
  ],
  "author": "",
  "license": "MIT"
}
