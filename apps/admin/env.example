# Base URL for Nitro server (optional)
# NUXT_APP_BASE_URL=http://localhost:3000

# SQLite database location (relative paths resolve from apps/admin/)
DB_PATH=../data/smokes.db

# Telegram bot token (required for media proxy)
BOT_TOKEN=your_bot_token_here

# Example: enable debug logging for database init
# LOG_LEVEL=debug

