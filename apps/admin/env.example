# Base URL for Nitro server (optional)
# NUXT_APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cs2_bot

# Telegram bot token (required for media proxy and authentication)
BOT_TOKEN=your_bot_token_here

# Telegram bot username (required for Telegram Login Widget)
# Get this from @BotFather when creating your bot
BOT_USERNAME=your_bot_username

# Example: enable debug logging for database init
# LOG_LEVEL=debug

# Admin user IDs (comma-separated Telegram user IDs)
# Only users with IDs listed here will be able to access the admin panel
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Storage path for uploaded files (optional)
# Default: storage/uploads in project root
# Example: STORAGE_PATH=/var/www/uploads
# STORAGE_PATH=

